# Root environment for docker-compose (production-shaped base).
#
# Copy to a gitignored `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; never commit real secrets.
#
# Values below are OBVIOUSLY-FAKE placeholders, not real credentials.

# --- Postgres ---
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password
POSTGRES_DB=bazaar

# --- Backend wiring (override only if you change ports/hosts) ---
HTTP_ALLOWED_ORIGINS=http://localhost:3000
APP_BACKEND_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000
ETH_URL=ws://hardhat:8545
CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
STORAGE_DRIVER=local
SMTP_SKIP_SEND=true

# --- Frontend public config (override only if you change addresses/chain) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_CHAIN_ID=0x7a69
NEXT_PUBLIC_CHAIN_NAME=Hardhat Local
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CDN_BASE_URL=http://localhost:8000/api/uploads
NEXT_PUBLIC_ETHERSCAN_TX_BASE_URL=
NEXT_PUBLIC_ESCROW_RELEASE_DAYS=14
NEXT_PUBLIC_PLATFORM_FEE_BPS=200
NEXT_PUBLIC_E2E=false
